{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.0.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "block-spam-keys@thunderbird-block-spam",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "bareKeys": {
      "schema": "api/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["bareKeys"]],
        "script": "api/implementation.js"
      }
    }
  }
}
