{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.0.0",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "block-spam@thunderbird-block-spam",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["personalCommunications", "personallyIdentifyingInfo"]
      }
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["accountsRead", "messagesRead", "messagesMove", "compose", "storage", "alarms", "notifications", "menus"],
  "optional_permissions": ["accountsFolders", "webRequest"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "commands": {
    "block-address": {
      "suggested_key": { "default": "Alt+B" },
      "description": "__MSG_cmdBlockAddress__"
    },
    "block-domain": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "__MSG_cmdBlockDomain__"
    },
    "trust-address": {
      "suggested_key": { "default": "Alt+W" },
      "description": "__MSG_cmdTrustAddress__"
    },
    "trust-domain": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "__MSG_cmdTrustDomain__"
    }
  }
}
